# ─────────────────────────────────────────────────────────────
# Bu dosyayı '.env' olarak KOPYALA ve değerleri doldur.
#   cp .env.example .env
# '.env' ASLA commit edilmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────

# ── Sunucu ──
PORT=3000
# Public URL of this server (WhatsApp fetches quote PDFs from it; patients
# click quote-tracking links built from it). Leave as localhost for dev —
# quote PDFs still generate and dry-run "sends" still log, they just won't be
# fetchable by anything outside this machine. Set to your real domain before
# sending a quote to a real patient.
PUBLIC_BASE_URL=http://localhost:3000
# Chromium-family browser used to render quote PDFs (see src/services/pdf.js).
# Auto-detected on macOS/Linux common install paths; set this if yours isn't
# found, or to point at a specific install.
CHROME_PATH=

# ── Panel access (Adım 6 — güvenlik) ──
# Boş bırakırsan panel ve /api uçları AÇIK kalır — sadece lokal geliştirmede
# kabul edilebilir. Herkese açık bir sunucuya koymadan önce mutlaka doldur.
# Üret:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Panel ilk açılışta bunu soracak ve tarayıcıda saklayacak (her istekte
# Authorization: Bearer <token> gönderir). Widget'ın /api/public uçları ve
# hastanın teklif izleme linki bu korumanın DIŞINDADIR — kasıtlı, onlar
# panel oturumu olmayan dış ziyaretçiler için var.
PANEL_API_TOKEN=

# ── WhatsApp Cloud API (Meta) ──
# Aşağıdaki iki değeri BOŞ bırakırsan gönderim dry-run kalır (sadece log) —
# lokal testte AI'yı denemek için idealdir. Gerçek gönderim için Meta'dan doldur.
WHATSAPP_VERIFY_TOKEN=kendi-belirledigin-rastgele-bir-string
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opsiyonel ama prodüksiyonda önerilir: webhook imza doğrulamasını açar.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ── Instagram DM + Facebook Messenger ──
# Aynı Meta App'i ve YUKARIDAKİ aynı /webhook callback URL'i ve
# WHATSAPP_VERIFY_TOKEN'ı kullanır (Meta bir App'i whatsapp_business_account,
# instagram ve page ürünlerine aynı callback altında abone etmene izin verir) —
# tek yeni değer bu Page Access Token. Instagram hesabın o Page'e bağlıysa
# (standart kurulum) aynı token ikisini de kapsar. Boş bırakırsan gönderim
# dry-run kalır (sadece log).
META_PAGE_ACCESS_TOKEN=

# ── AI concierge (Anthropic Claude) ──
# Boş bırakırsan echo mode. Anahtarı console.anthropic.com'dan al (kredi gerekir).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# ── Sesli mesaj çözümü (OpenAI Whisper) ──
# Boş bırakırsan hasta sesli mesaj attığında sistem yazıyla yazmasını ister —
# uygulama yine çalışır, sadece o mesajı çözemez. Anahtarı platform.openai.com'dan al.
OPENAI_API_KEY=

# ── Uluslararası ödeme/kapora linkleri (Stripe) ──
# Boş bırakırsan sistem dry-run kalır: link "oluşturulur" (sahte bir URL) ve
# hastanın kanalına "gönderilir" (sadece log) — tüm akışı gerçek bir Stripe
# hesabı olmadan uçtan uca test edebilirsin. Anahtarı dashboard.stripe.com'dan al.
STRIPE_SECRET_KEY=
# Webhook imzasını doğrular (routes/stripeWebhook.js) — WHATSAPP_APP_SECRET
# gibi opsiyonel ama gerçek bir Stripe hesabı bağlamadan ÖNCE doldurulmalı:
# bu olmadan sahte bir "ödeme alındı" isteği bir depozitoyu gerçekte
# ödenmemişken ödendi olarak işaretleyebilir. Stripe Dashboard → Webhooks →
# endpoint'i https://<domainin>/webhooks/stripe olarak ekleyip oradan al.
STRIPE_WEBHOOK_SECRET=

# ── İyzico (TRY kapora/ödeme linkleri) ──
# Boş bırakırsan dry-run — link "oluşturulur" ama gerçek tahsilat yapılmaz,
# tıpkı Stripe gibi. Para birimi TRY olan ödeme linkleri otomatik İyzico'ya,
# diğerleri (EUR/USD/GBP) Stripe'a gider — bkz. src/routes/api.js
# defaultProviderFor(). Anahtarları merchant.iyzipay.com'dan al.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox anahtarlarıyla test ederken şunu ekle (İyzico'da test/canlı ayrı
# host'larda, Stripe'ın aksine — orada anahtar öneki yeterli):
#   IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_BASE_URL=https://api.iyzipay.com

# ── Veritabanı (PostgreSQL) ──
# Boş bırakırsan bellek-içi store kullanılır (restart'ta sıfırlanır).
# Doldurursan konuşmalar/lead'ler kalıcı olur. Lokal örnek:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medivoyage

# ── Zoho CRM (Adım 5) ──
# Üçünü de boş bırakırsan CRM senkronu kapalı kalır (uygulama yine çalışır).
# refresh_token'ı 'node zoho-get-refresh-token.mjs ...' ile üretirsin.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Bölgene göre değiştir (.eu / .in / .com.au). Vermezsen .com varsayılır:
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
ZOHO_API_HOST=https://www.zohoapis.com

# ── Devir bildirimi + SLA Alarmı ──
# Boş bırakırsan devirler sadece panelin Action Center kuyruğunda görünür,
# dışarı hiçbir bildirim gitmez. Slack "Incoming Webhook" URL'i veya JSON
# { text } kabul eden herhangi bir webhook olabilir.
HANDOVER_WEBHOOK_URL=
# Opsiyonel: ikinci kademe ("hâlâ cevapsız") uyarısı için AYRI bir webhook
# (örn. yöneticinin kendi kanalı). Boş bırakırsan aynı HANDOVER_WEBHOOK_URL
# kullanılır — mesaj yine de "ESCALATED" olarak ayırt edilebilir şekilde gelir.
HANDOVER_SLA_MANAGER_WEBHOOK_URL=
# Bir devir Action Center kuyruğunda kaç dakika cevapsız kalırsa koordinatöre
# hatırlatma (ilk kademe), kaç dakikada yöneticiye yükseltme (ikinci kademe)
# gönderilsin. İkinci değer birinciden BÜYÜK olmalı — değilse başlangıçta uyarı basılır.
HANDOVER_SLA_FIRST_REMINDER_MINUTES=10
HANDOVER_SLA_ESCALATE_MINUTES=30

# ── İzleme ve hata uyarısı ──
# AI kesintisi (ardışık başarısız yanıt), Stripe/İyzico webhook'unun bir
# ödemeyi işleyemediği durumlar, ve yakalanmamış istisnalar için ayrı bir
# kanal. Boş bırakırsan HANDOVER_WEBHOOK_URL'e düşer (aynı kanala karışır ama
# hiç bildirim kaybolmaz); bir mühendislik/ops Slack kanalın varsa onu ver,
# koordinatörlerin kanalı "AI çöktü" gürültüsüyle dolmasın.
SYSTEM_ALERT_WEBHOOK_URL=
