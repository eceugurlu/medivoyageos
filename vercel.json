{
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/postop", "schedule": "0 7 * * *" },
    { "path": "/api/cron/risk", "schedule": "30 7 * * *" },
    { "path": "/api/cron/hotleads", "schedule": "0 8 * * *" },
    { "path": "/api/cron/weeklyreport", "schedule": "0 7 * * 1" }
  ]
}
